    },
    {
      "source": "http://www.talenthub-portal.vercel.app/(.*)",
      "destination": "https://talenthub-portal.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "https://www.talenthub-portal.vercel.app/(.*)",
      "destination": "https://talenthub-portal.vercel.app/$1",
      "permanent": true
    }
  ]
}
